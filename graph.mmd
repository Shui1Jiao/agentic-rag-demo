---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	judge(judge)
	retrieve(retrieve)
	tool_call(tool_call)
	answer(answer)
	__end__([<p>__end__</p>]):::last
	__start__ --> judge;
	judge -.-> answer;
	judge -.-> retrieve;
	judge -.-> tool_call;
	retrieve --> answer;
	tool_call --> answer;
	answer --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
